# Sanity (project "KFOCO dashboard"). The two NEXT_PUBLIC values already default to these in code.
NEXT_PUBLIC_SANITY_PROJECT_ID=mrjotrl0
NEXT_PUBLIC_SANITY_DATASET=production
# Optional: only needed if the dataset is made private
SANITY_API_READ_TOKEN=
# Optional: secret for the instant-update webhook (POST /api/revalidate?secret=...)
SANITY_REVALIDATE_SECRET=
# Only for the one-time seed script (never set this in Vercel)
SANITY_API_WRITE_TOKEN=
